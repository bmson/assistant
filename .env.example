# ── Assistant installation ──────────────────────────────────────────────────
# Identity is seeded once. Keep ASSISTANT_EMAIL and ASSISTANT_WORKSPACE_ID stable
# after first boot because they identify durable database and storage records.
ASSISTANT_NAME=Assistant
ASSISTANT_EMAIL=assistant@example.com
ASSISTANT_WORKSPACE_ID=assistant
ASSISTANT_TIMEZONE=UTC
ASSISTANT_LOCALE=en
ASSISTANT_SIGNATURE=— Assistant

# Base chat, memory, goals, approvals, missions, and workspace are always on.
# Optional: browser,code,documents,google,reminders,search,sms,watches
# Use "all", "minimal", or a comma-separated list.
ASSISTANT_MODULES=all

# ── Database ────────────────────────────────────────────────────────────────
# Local: docker compose db service. Prod: Neon connection string (Secret Manager).
DATABASE_URL=postgres://assistant:assistant@localhost:5432/assistant
POSTGRES_SOURCE_WRITES_FENCED=false
# Opt-in local restore profile: requires a dedicated assistant_restore_reader role,
# a unique assistant_restore_<runid>_test database and separate _files workspace.
ASSISTANT_RELEASE_WRITES_PAUSED=false
RESTORE_REHEARSAL=false
RESTORE_REHEARSAL_ROOT=
# Optional local browser chat preview. Requires NODE_ENV=development and loopback AUTH_URL/host.
WEB_APP_PREVIEW_ENABLED=false
# Agent-only Firestore preview: set all three, ASSISTANT_MODULES=minimal,
# and QUEUE_DRIVER=local. PostgreSQL remains the default application driver.
PERSISTENCE_DRIVER=postgres
# Set this to the provisioned Firestore database, such as assistant-production.
# Production Firestore mode requires an explicit database ID so it cannot
# silently write to (default) instead of the selected installation database.
# FIRESTORE_DATABASE_ID=
# FIRESTORE_AGENT_ID=
# FIRESTORE_EMBEDDING_SPACE=
# Used only by the one-command GCP provisioner and --prod maintenance scripts.
PROD_DATABASE_URL=
# Connection pool, per process. Every service builds its own, so what the
# database sees is this times the number of running containers — raise the
# ceiling with care, and check it against the server's own max_connections.
# DB_POOL_MAX=10
# Close a connection nobody has used for this long, so an idle container stops
# holding a slot it is not using.
# DB_IDLE_TIMEOUT_SECONDS=30
# DB_CONNECT_TIMEOUT_SECONDS=10
# Backstop for a query that will never finish. Set it above the slowest query
# you legitimately run — 0 disables it.
# DB_STATEMENT_TIMEOUT_MS=60000

# ── Models (OpenRouter by default; optional Vertex) ───────────────────────────────
# https://openrouter.ai/settings/keys — set a spend limit on the key itself.
OPENROUTER_API_KEY=
# Vertex uses the runtime service account / ADC in this explicit customer project.
# Configure the model catalog and every model role with vertex:MODEL_ID and rates
# before selecting it. Existing OpenRouter IDs are rejected; vectors are not migrated.
LLM_PROVIDER=openrouter
VERTEX_PROJECT=
VERTEX_LOCATION=

# ── Owner ───────────────────────────────────────────────────────────────────
OWNER_NAME=Owner
OWNER_EMAIL=owner@example.com
OWNER_PHONE=

# ── Web auth (Auth.js) ──────────────────────────────────────────────────────
# Google OAuth client for signing in to the web UI (allowlisted to OWNER_EMAIL).
# Customer-owned Firestore installs can instead set OWNER_AUTH_MODE=passkey:
# WebAuthn passkeys with an installer-issued claim link, no OAuth client
# (requires PERSISTENCE_DRIVER=firestore, a 32+ character AUTH_SECRET, and an
# HTTPS AUTH_URL). See docs/consumer-owner-passkeys.md.
OWNER_AUTH_MODE=google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Canonical external URL of the web UI. Local dev can leave it empty (Auth.js
# infers localhost); production deploys set the Cloud Run or custom-domain URL.
AUTH_URL=
# Set true only behind a trusted reverse proxy that rewrites Host headers.
AUTH_TRUST_HOST=
# Native iOS app credential. Generate with `openssl rand -hex 32`, set the same
# value once in the app's connection screen, and keep it out of source control.
# Empty disables bearer-token access; browser session auth continues to work.
MOBILE_API_TOKEN=
# Optional Secret Manager rotation. Keep disabled unless the customer project
# has a dedicated secret resource and the rotation workflow is configured.
# MOBILE_API_TOKEN_SECRET_NAME=
MOBILE_API_TOKEN_ROTATION_ENABLED=false
# Owner auth is fail-closed when OAuth is absent. Set true only for source-based local dev.
AUTH_DEV_BYPASS=true
# Docker Compose overrides this for its loopback-published production image.
# Leave false everywhere else; it also requires loopback AUTH_URL and local queues.
# SECURITY: when true, the port MUST be bound to loopback (127.0.0.1) only. The
# per-request loopback check is a best-effort tripwire, not a boundary — a
# crafted X-Forwarded-For header defeats it — so exposing this port to the
# network with the bypass on hands an attacker the owner dashboard.
AUTH_LOCALHOST_BYPASS=false

# ── Google Workspace module ─────────────────────────────────────────────────
# OAuth client (Internal consent screen) + refresh token from scripts/auth-bot.ts.
# Grants Gmail, Calendar, and Google Docs/Drive (docs.file) scopes — rerun
# `pnpm auth:bot` after enabling the Docs/Drive APIs so the token carries them.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
BOT_GOOGLE_REFRESH_TOKEN=

# ── SMS module (Twilio) ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Push module (APNs) ──────────────────────────────────────────────────────
# Proactive pushes to the iOS app. Create an APNs auth key (.p8) at
# developer.apple.com → Certificates, IDs & Profiles → Keys, then:
#   APNS_PRIVATE_KEY=$(base64 -i AuthKey_XXXX.p8 | tr -d '\n')
# TEAM_ID is the 10-char membership id; BUNDLE_ID is the iOS app's bundle id
# (the APNs topic). All four empty = push module stands down (chat-only).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=

# ── Maps module (Apple Maps Server API) ─────────────────────────────────────
# Directions, travel times, and route maps. Enable MapKit on an Apple
# Developer key; leave these empty to reuse the APNS_* key above when that same
# key has MapKit enabled. Free up to 25,000 service calls a day.
MAPKIT_KEY_ID=
MAPKIT_TEAM_ID=
MAPKIT_PRIVATE_KEY=

# ── Drivers: local dev vs GCP ───────────────────────────────────────────────
# local = in-process queue poller / fake-gcs; cloudtasks|gcs = real GCP services
QUEUE_DRIVER=local
FILES_DRIVER=local
# fake-gcs-server endpoint for FILES_DRIVER=local
GCS_ENDPOINT=http://localhost:4443
WORKSPACE_BUCKET=assistant-workspace

# ── Public URL (webhooks) ───────────────────────────────────────────────────
# Local: cloudflared tunnel URL from scripts/dev-tunnel.sh. Prod: Cloud Run URL.
PUBLIC_URL=http://localhost:8787

# ── Isolated worker modules ─────────────────────────────────────────────────
# Encryption keys: 32 random bytes as 64 hex chars. Generate: openssl rand -hex 32
PROFILE_ENC_KEY=
MCP_ENC_KEY=
# local = detached child process (needs `pnpm --filter @assistant/browser-job exec playwright install chromium`)
# cloudrun = Cloud Run Job execution (prod; set by deploy.sh)
BROWSER_DRIVER=local
BROWSER_JOB_NAME=assistant-browser
# Code-execution worker: local = detached child process; cloudrun = Cloud Run Job.
CODE_DRIVER=local
CODE_JOB_NAME=assistant-code
# Document-processor worker: local = child process; cloudrun = Cloud Run Job.
PROCESSOR_DRIVER=local
PROCESSOR_JOB_NAME=assistant-processor
# Location context: HMAC-SHA256 key the owner's iOS Shortcut signs pings with.
# Empty = location ingest disabled (POST /webhooks/location returns 404).
LOCATION_PING_SECRET=
# Days a location ping is kept before the sweep purges it (transient by design).
LOCATION_RETENTION_DAYS=3

# ── Model output review ─────────────────────────────────────────────────────
# Keep what the models were asked and what they answered, in model_call_audit.
# The cost ledger alone records that a call happened and what it spent, so
# without this there is no way to review the assistant's own answers, compare a
# routing change against real traffic, or catch a quality regression before you
# notice one by hand.
#
# off      — nothing is stored (default).
# redacted — email addresses, phone numbers, long digit runs (bookings, account
#            and card numbers) and URL paths are scrubbed first. Dates, times,
#            amounts and scores are deliberately kept: they are what makes a
#            record worth reading.
# full     — stored verbatim. More useful for checking whether an answer was
#            actually grounded in its evidence, and a far more sensitive table.
#
# These rows contain your mail, calendar and conversations. Turn this on for a
# single-owner installation reviewing its own assistant; think twice where the
# mailbox carries anyone else's correspondence. Nothing reads this table back
# into a prompt — it is review telemetry, never an input to the assistant.
LLM_AUDIT_CAPTURE=off
# Days a captured prompt/answer is kept before the sweep purges it.
LLM_AUDIT_RETENTION_DAYS=14

# ── History retention ───────────────────────────────────────────────────────
# Messages, tool calls, model calls, and cost events grow without bound unless
# these are set. 0 = keep forever (default — pruning your own history is your
# call, not the platform's). Suggested once things settle: 180 and 400.
# History: minimum 30. Messages summarized into a conversation segment are
# kept regardless — the summary references them.
HISTORY_RETENTION_DAYS=0
# Cost ledger: minimum 60, because budget caps count a rolling month of spend —
# pruning inside that window would quietly raise the limit.
COST_RETENTION_DAYS=0
# Trace-archive bucket (30-day lifecycle). Empty = traces land in the workspace store.
TRACES_BUCKET=

# ── Real integration canaries ───────────────────────────────────────────────
# Explicit opt-in: each run self-sends/deletes one Gmail message, sends one SMS
# to OWNER_PHONE, launches one browser job, denies a synthetic approval, and
# streams one tiny model reply. The structural ceiling is checked before launch.
CANARY_ENABLED=false
VERTEX_MODEL_PROBE_ENABLED=false # Private authenticated Vertex connectivity probe; Firestore + Vertex only.
CANARY_MAX_COST_USD=0.03

# ── Long-running chat ───────────────────────────────────────────────────────
# Auto-recall (Phase 1): each owner chat turn injects a bounded block of
# relevant earlier discussion pulled from the owner's own past chats via the
# existing message embeddings, so one thread feels continuous. Off by default.
CHAT_RECALL_ENABLED=false
# Compose grounded native cards for structured results that have no handwritten renderer.
GENERATIVE_CARDS_ENABLED=true
# Let cardable non-bulk inbox items earn a saved card even when they are not urgent.
PROACTIVE_CARDS_ENABLED=true
# Graph-backed personal-memory recall. Requires CHAT_RECALL_ENABLED=true; it
# remains off while the graph backfill runs and recall quality is evaluated.
GRAPH_RAG_ENABLED=false
# Source memories the offline graph sync extracts per run (2 runs/hour). This
# paces a backfill more than the budget does; raise it to drain a backlog
# sooner, lower it to spend less per day. The per-run budget cap still applies.
GRAPH_SYNC_BATCH_LIMIT=25

# ── OpenTelemetry ───────────────────────────────────────────────────────────
# none (default): no-op, zero overhead. console: spans to stdout for local use.
# otlp: OTLP/HTTP export — set OTEL_EXPORTER_OTLP_ENDPOINT (a collector sidecar
# or a managed OTLP ingest); the exporter reads the standard OTEL_EXPORTER_OTLP_*
# vars for endpoint and headers.
OTEL_SERVICE_NAME=assistant
OTEL_EXPORTER=console
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Service ports ───────────────────────────────────────────────────────────
WEB_PORT=3000
AGENT_PORT=8787
# Local-only internal callback authentication. Production deploys with OIDC.
INTERNAL_AUTH_MODE=shared-secret
# Needed only when calling /internal/* locally: openssl rand -hex 32
INTERNAL_API_SECRET=

# ── Cloud deploy (QUEUE_DRIVER=cloudtasks) — set by infra/gcp/deploy.sh ──────
# These are empty locally (QUEUE_DRIVER=local). In production they are REQUIRED:
# validateProdConfig() throws at agent startup if QUEUE_DRIVER=cloudtasks and
# any of AGENT_URL / INTERNAL_OIDC_* is empty, so a misconfigured deploy fails
# loudly instead of silently breaking the queue.
GCP_PROJECT=
# Optional real Google Cloud spend, from standard/detailed Cloud Billing export.
# See docs/cost-tracking.md for export setup, IAM and reporting limitations.
GCP_BILLING_EXPORT_TABLE=
GCP_BILLING_QUERY_PROJECT=
GCP_BILLING_LOCATION=US
GCP_BILLING_SCOPE=project
GCP_BILLING_MAX_BYTES=1000000000
GCP_LOCATION=us-west1
ARTIFACT_REPOSITORY=assistant
# Optional custom domain for the dashboard. Leave empty to use the Cloud Run URL.
WEB_DOMAIN=
CLOUD_TASKS_QUEUE=agent-steps
# The agent service's own public URL — the Cloud Tasks callback target.
AGENT_URL=
# projects/<id>/topics/<name> — enables Gmail push; local dev polls instead.
GMAIL_PUBSUB_TOPIC=
# Expected `email` claim on the Pub/Sub push OIDC token. REQUIRED if GMAIL_PUBSUB_TOPIC
# is set (an unauthenticated push 403s — the two-day email blackout).
GMAIL_PUSH_SERVICE_ACCOUNT=
# Gmail sync on/off. Unset = ON only in production (NODE_ENV=production). Leave
# unset locally so a dev agent sharing the prod bot token does NOT double-triage
# the live mailbox; set 'true' only to deliberately test sync locally.
GMAIL_SYNC_ENABLED=
# Durable email-observer drain remains paused until observer effects pass acceptance.
# Local worker trials also need GMAIL_SYNC_ENABLED=true and Google credentials;
# that enables Gmail polling too, so use a dedicated test mailbox.
EMAIL_OBSERVER_WORKER_ENABLED=false
# What this mailbox is. 'direct' (default): people write to the assistant, and
# the sender is the party directing it — sender trust decides what the resulting
# task may do. 'forwarded': the owner forwards their own mail here, so the OWNER
# directs and the sender is only content. In forwarded mode nothing is dropped
# as "automated", every message is stored and scored, tasks run at owner trust
# but tainted, and the assistant NEVER auto-replies to a sender.
EMAIL_INGEST_MODE=direct
# How interesting (1-5) a forwarded message must be to earn a full triage task.
# Below this it is still stored, searchable and remembered — it just does not
# interrupt you or spend reasoning budget. Raise it if you get pinged too often.
EMAIL_INGEST_IMPORTANCE_THRESHOLD=3
# How important (1-5) a forwarded message must be to ping you the moment it
# lands — a deterministic heads-up in chat (and SMS when configured), not left
# to the triage task's judgment. Default 4: mail that needs you to act — a person
# waiting on you, a failed or due payment, a changed booking, a near deadline.
# Mail that asks nothing of you (confirmations, receipts, sign-in notices) is
# held at 3 in code, so it reaches the briefing without buzzing your phone.
EMAIL_INGEST_NOTIFY_THRESHOLD=4
# Daily ceiling on deep triage tasks from forwarded mail. Owner-trust tasks skip
# the external-sender flood backstop, so ingest needs its own brake.
EMAIL_INGEST_MAX_TRIAGE_PER_DAY=40
# Separate daily limit for paid email observers such as card composition and voice embeddings.
EMAIL_OBSERVER_MAX_PAID_PER_DAY=20
# Comma-separated recipient domains the assistant may email; empty = no limit.
# Set this to mirror a restriction your mail provider already enforces (e.g. a
# bot account blocked from mailing outside its own org). Sends outside the list
# are REJECTED outright rather than queued for approval, so you are never asked
# to approve mail that would bounce. Subdomains are not implied.
EMAIL_OUTBOUND_DOMAINS=
# Base audience for per-route internal OIDC (usually the agent service URL).
INTERNAL_OIDC_AUDIENCE=
# Service account whose ID token is accepted on /internal/* in production.
INTERNAL_OIDC_SERVICE_ACCOUNT=
# Web search: backs the web.search tool (the browse ladder's discovery entry point).
# Provider: brave (free ~2k/mo) | tavily | serper. Empty/none = web.search disabled.
# (No Google option — Google discontinued whole-web Custom Search in Mar 2026.)
SEARCH_PROVIDER=none
SEARCH_API_KEY=
# Self-repair: runtime token needs Actions write on the private worker plus Contents/PR read on source.
# Publishing uses a SEPARATE GitHub Actions secret with Contents/PR write; see docs/self-repair.md.
GITHUB_TOKEN=
GITHUB_REPO=owner/assistant
SELF_REPAIR_ENABLED=false
# github preserves existing installations; openai_hosted runs coding through the Agents API.
SELF_REPAIR_PROVIDER=github
SELF_REPAIR_CODING_MODEL=gpt-6.1-sol
SELF_REPAIR_REASONING_EFFORT=medium
# Hosted mode only: dedicated backend secrets, never passed into the coding sandbox.
SELF_REPAIR_OPENAI_API_KEY=
SELF_REPAIR_GITHUB_TOKEN=
# Private Actions repository; required when the source repository is public.
SELF_REPAIR_WORKER_REPO=
# Separate explicit tier: selected executor internals only, still owner-reviewed PRs.
SELF_REPAIR_ALLOW_EXECUTOR=false
# Coding dispatches per rolling 24 hours (investigation uses ordinary assistant budgets).
SELF_REPAIR_DAILY_LIMIT=2
SELF_REPAIR_WORKFLOW=self-repair.yml
SELF_REPAIR_REF=main
# Used to confirm the deployed SHA includes a merged fix, e.g. https://assistant.example.com
SELF_REPAIR_DEPLOYMENT_URL=

# ── Phone calls module (run `pnpm setup:phone` to fill these in) ─────────────
# Caller ID for outbound calls; defaults to TWILIO_FROM_NUMBER.
TWILIO_VOICE_FROM_NUMBER=
# Country codes the assistant may dial, comma-separated (default: US/Canada).
CALL_ALLOWED_COUNTRY_CODES=1
CALL_DAILY_LIMIT=10
CALL_MAX_MINUTES=15
# The dashboard's public URL, for links in call check-ins.
WEB_URL=

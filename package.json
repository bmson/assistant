{
  "name": "assistant",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "esbuild@<=0.24.2": "0.25.12",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.23": "8.5.23",
      "sharp@<0.35.5": "0.35.5",
      "source-map-js@<1.2.2": "1.2.2",
      "uuid@<11.1.1": "11.1.1",
      "@xmldom/xmldom@<0.8.15": "0.8.15",
      "lodash-es@<4.18.0": "4.18.1",
      "google-auth-library@>=10.0.0 <11.0.0": "10.9.1",
      "mammoth>argparse": "2.0.1"
    }
  },
  "scripts": {
    "brand:generate": "tsx scripts/generate-brand-assets.ts",
    "brand:check": "tsx scripts/generate-brand-assets.ts --check",
    "setup": "tsx scripts/setup.ts",
    "firestore:indexes": "tsx scripts/firestore-target-indexes.ts",
    "visual-qa:cleanup": "tsx scripts/visual-qa/cleanup-fixtures.ts",
    "config:check": "tsx scripts/config-doctor.ts",
    "support:matrix:check": "node scripts/runtime-support-matrix.mjs --check",
    "ios:generated-card-contract:check": "tsx scripts/generate-ios-card-capability-manifest.ts --check",
    "ios:generated-card-contract:write": "tsx scripts/generate-ios-card-capability-manifest.ts",
    "test:ios-generated-card-contract": "vitest run scripts/generated-card-capability-parity.test.ts packages/persistence/src/card-capabilities.test.ts",
    "support:matrix:write": "node scripts/runtime-support-matrix.mjs --write",
    "modules:plan": "tsx scripts/module-plan.ts",
    "install:plan": "tsx scripts/installation-plan.ts",
    "install:state": "tsx scripts/installation-state.ts",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "dev": "turbo dev",
    "up": "docker compose up --build",
    "build": "turbo build",
    "setup:phone": "tsx scripts/setup-phone.ts",
    "test": "tsx scripts/test.ts",
    "lint": "biome check . && pnpm check:boundaries && pnpm check:migrations && pnpm support:matrix:check && pnpm ios:generated-card-contract:check",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "db:generate": "pnpm --filter @assistant/db generate",
    "db:migrate": "pnpm --filter @assistant/db migrate",
    "seed": "pnpm --filter @assistant/db seed",
    "auth:bot": "tsx scripts/auth-bot.ts",
    "voice:ingest": "tsx scripts/ingest-voice.ts",
    "smoke:mobile": "tsx scripts/mobile-smoke.ts",
    "setup:wizard": "tsx scripts/wizard.ts",
    "test:questions": "pnpm test packages/tools/src/question-regression packages/application/src/chat-budget-reply.test.ts",
    "audit:llm": "tsx scripts/llm-audit.ts",
    "eval:questions": "tsx scripts/question-regression.ts",
    "eval:questions:config": "tsx scripts/question-regression-config.ts",
    "eval:models": "tsx scripts/eval-models.ts",
    "test:firestore": "tsx scripts/test-firestore.ts",
    "firestore:validate": "tsx scripts/validate-firestore.ts",
    "firestore:backup-smoke": "tsx scripts/firestore-backup-smoke.ts",
    "firestore:runtime-data-preflight": "tsx scripts/firestore-runtime-data-preflight.ts",
    "recovery:postgres-restore-preflight": "tsx scripts/postgres-restore-drill.ts --check-target",
    "recovery:postgres-restore-profile-check": "tsx scripts/postgres-restore-drill.ts --check-profile",
    "recovery:goal-session": "tsx scripts/reconcile-goal-session-orphans.ts",
    "workspace:export": "tsx scripts/workspace-migration-export.ts",
    "workspace:import": "tsx scripts/workspace-migration-import.ts",
    "workspace:assets-audit": "tsx scripts/workspace-asset-audit.ts",
    "workspace:assets-recover": "tsx scripts/workspace-asset-recovery.ts",
    "cutover": "tsx scripts/cutover.ts",
    "cutover:neon-fence": "tsx scripts/cutover-neon-fence.ts",
    "cutover:retirement-report": "tsx scripts/cutover-retirement-report.ts",
    "schedule:recovery-report": "tsx scripts/schedule-recovery-report.ts",
    "model-routing:review-report": "tsx scripts/model-routing-review-report.ts",
    "consumer:install": "tsx scripts/consumer-install.ts",
    "consumer:prepare": "tsx scripts/consumer-prepare.ts",
    "consumer:seed-runtime": "tsx scripts/consumer-runtime-seed.ts",
    "consumer:owner-claim": "tsx scripts/consumer-owner-claim.ts",
    "consumer:update": "tsx scripts/consumer-update.ts",
    "consumer:uninstall": "tsx scripts/consumer-uninstall.ts",
    "consumer:publish-images": "tsx scripts/consumer-publish-images.ts",
    "verify:goal-session": "tsx scripts/verify-goal-session.ts",
    "check:migrations": "tsx scripts/check-migrations.ts"
  },
  "devDependencies": {
    "@assistant/config": "workspace:^",
    "@assistant/core": "workspace:^",
    "@assistant/db": "workspace:^",
    "@assistant/firestore": "workspace:*",
    "@assistant/modules": "workspace:*",
    "@assistant/persistence": "workspace:*",
    "@assistant/setup": "workspace:*",
    "@assistant/tools": "workspace:*",
    "@biomejs/biome": "^2.5.15",
    "@google-cloud/firestore": "^9.3.1",
    "@types/node": "^26.6.4",
    "drizzle-orm": "^0.45.3",
    "google-auth-library": "^10.9.1",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}

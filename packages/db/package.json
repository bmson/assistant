{
  "name": "@assistant/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./workspace-migration": "./src/workspace-migration.ts",
    "./test-target": "./src/test-target.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "repair-agent-identity": "tsx src/repair-agent-identity.ts",
    "diagnose-schema": "tsx src/diagnose-schema.ts",
    "reconcile": "tsx src/reconcile.ts",
    "workspace-export-job": "tsx src/workspace-export-job-cli.ts",
    "reconcile:direct": "pnpm migrate && pnpm repair-agent-identity && pnpm seed",
    "seed": "tsx src/seed.ts",
    "test:prepare": "tsx src/test-db.ts && pnpm migrate && pnpm seed",
    "test:cleanup": "tsx src/cleanup-test-db.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@assistant/config": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "@assistant/persistence": "workspace:*"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
